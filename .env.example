# Test account: matt-lee-z3e7eh — embeds full profile (all event types)
# Production: set Cara's Cal.com username when ready
NEXT_PUBLIC_CAL_USERNAME=

# Optional: for scripts/setup-cal-events.mjs (Settings → Developer → API Keys)
# CAL_API_KEY=

# Payload CMS
# Neon Postgres connection string (added by the Vercel Neon integration; pull with `vercel env pull .env.local`)
DATABASE_URL=
# Long random string used to sign Payload auth tokens (e.g. `openssl rand -hex 32`)
PAYLOAD_SECRET=
# Vercel Blob read/write token (added when a Blob store is connected to the project)
BLOB_READ_WRITE_TOKEN=
